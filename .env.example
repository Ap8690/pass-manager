# Postgres connection. Defaults to postgres://postgres:postgres@localhost:5432/pass_manager
# Hosted providers (Neon, Supabase, Vercel Postgres) usually need ?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pass_manager

# Optional: when set, creating an account requires this code. Recommended once the
# app is on the public internet, otherwise anyone can sign up.
SIGNUP_CODE=
